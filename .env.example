# Copy to your Flutter *host app* as `.env` (do not put keys in this SDK package).
# The SDK reads values from ConveyGridConfig you pass in Dart — not from this file.

CONVEYGRID_APPLICATION_KEY=your_application_key
CONVEYGRID_API_BASE_URL=https://your-conveygrid-host.example
CONVEYGRID_DF_ORIGIN=https://your-allowed-origin.example
CONVEYGRID_DF_REFERER=https://your-allowed-origin.example/
CONVEYGRID_COOKIE_CONFIG_CODE=YOUR_COOKIE_CONFIG_CODE
CONVEYGRID_BOOKING_NOTICE_CODE=YOUR_NOTICE_CODE
